{
  "name": "@realpolitik/root",
  "version": "0.1.0",
  "private": true,
  "description": "Realpolitik Manager – monorepo root",
  "scripts": {
    "prelint": "pnpm --filter @realpolitik/shared build",
    "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "prelint:fix": "pnpm --filter @realpolitik/shared build",
    "lint:fix": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,md}\"",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.1"
}
