{
  "name": "@realpolitik/shared",
  "version": "0.1.0",
  "description": "Tipos compartidos, schemas Zod y utilidades para el monorepo Realpolitik Manager",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "~4.1.11",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "~4.1.11"
  }
}
