# Variables para Docker Compose (entorno de desarrollo local con `docker compose up`).
# Copiá este archivo a .env (Git lo ignora) y completalo.
POSTGRES_USER=realpolitik
POSTGRES_PASSWORD=realpolitik_dev
POSTGRES_DB=realpolitik_db
POSTGRES_PORT=5432

# UID/GID con los que corren los contenedores de Node (no root). Default: 1000 (usuario `node`).
# En Linux/macOS poné los tuyos (`id -u` / `id -g`) para que los archivos generados en el repo
# sean tuyos. En Windows/WSL2 dejá 1000.
UID=1000
GID=1000
