{
  "name": "@realpolitik/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @realpolitik/shared build",
    "predev": "pnpm run build:shared",
    "dev": "vite",
    "pretypecheck": "pnpm run build:shared",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm run build:shared",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "pnpm run build:shared",
    "test": "vitest run --exclude \"**/*.api.test.tsx\"",
    "pretest:api": "pnpm run build:shared",
    "test:api": "node -e \"if(!process.env.TEST_API_URL||!process.env.TEST_DATABASE_URL){console.error('test:api necesita TEST_API_URL (un backend contra una base descartable) y TEST_DATABASE_URL (esa misma base, *_audit o *_test).');process.exit(1)}\" && vitest run .api.test.tsx",
    "pretest:watch": "pnpm run build:shared",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "~1.8.0",
    "@fontsource/ibm-plex-mono": "~5.3.0",
    "@fontsource/ibm-plex-sans": "~5.3.0",
    "@realpolitik/shared": "workspace:^",
    "@tanstack/react-query": "~5.104.1",
    "class-variance-authority": "~0.7.1",
    "cn": "~0.4.0",
    "lucide-react": "~1.49.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hook-form": "~7.89.0",
    "react-router": "~7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "jsdom": "~29.1.1",
    "shadcn": "~4.21.1",
    "tailwindcss": "~4.3.3",
    "tw-animate-css": "~1.4.0",
    "typescript": "^5.5.4",
    "vite": "~8.3.2",
    "vitest": "~4.1.11"
  }
}
