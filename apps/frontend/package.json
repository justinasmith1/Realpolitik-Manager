{
  "name": "@realpolitik/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @realpolitik/shared build",
    "predev": "pnpm run build:shared",
    "dev": "vite",
    "pretypecheck": "pnpm run build:shared",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm run build:shared",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@realpolitik/shared": "workspace:^",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.5.4",
    "vite": "~8.3.2"
  }
}
