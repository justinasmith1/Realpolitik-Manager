generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (isomorfos al schema Zod en @realpolitik/shared) ──────────────────

enum Sector {
  PUBLICO
  PRIVADO
}

enum SubtipoPublico {
  MUNICIPAL
  PROVINCIAL_ORGANISMO
  SINDICAL_OBRA_SOCIAL
}

enum IvaCondicion {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_CATEGORIZADO
}

enum ClienteEstado {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

/// Canal habitual por el que se entregan las rendiciones al cliente (HU1.4).
enum CanalEntrega {
  CORREO
  PORTAL_WEB
  WHATSAPP
}

/// Periodicidad con la que se rinde al cliente (HU1.5).
enum PeriodicidadTipo {
  MENSUAL
  BIMESTRAL
  POR_CAMPANIA
}

// ─── Modelo Cliente ───────────────────────────────────────────────────────────

// TODO [DEUDA TÉCNICA]: La regla de negocio "si sector = PUBLICO entonces subtipo != null"
// no puede expresarse como CHECK constraint en Prisma v5 con tipos ENUM.
// Se valida únicamente en la capa de aplicación (Zod discriminatedUnion).
// Evaluar en versiones futuras de Prisma o migrar Sector/Subtipo a tablas relacionales (ADR futuro).

model Cliente {
  id            String  @id @default(uuid()) @db.Uuid

  // Datos de identificación
  razonSocial   String  @db.VarChar(150)
  /// Denominación corta o alias del cliente. Obligatorio. Máx 60 chars.
  /// Es el identificador visual principal en la UI cuando razonSocial es extensa.
  denominacion  String  @db.VarChar(60)

  // Datos fiscales y de contacto
  cuit               String   @unique @db.VarChar(13) // formato XX-XXXXXXXX-X
  ivaCondicion       IvaCondicion
  emailContacto      String   @db.VarChar(254)
  emailsAdicionales  String[] @default([])
  telefono           String?  @db.VarChar(25)
  portalUrl          String?  @db.VarChar(500)

  // Canal de entrega habitual
  // TODO [DEUDA TÉCNICA]: "PORTAL_WEB ⇒ portalUrl != null" y "WHATSAPP ⇒ whatsappNumero != null"
  // se validan solo en la capa de aplicación (Zod superRefine), igual que sector/subtipo.
  canalEntrega       CanalEntrega @default(CORREO)
  /// Número de WhatsApp normalizado a E.164 (+5493511234567). Obligatorio si canalEntrega = WHATSAPP.
  whatsappNumero     String?  @db.VarChar(16)

  // Periodicidad de rendición (HU1.5). Sin configurar = las tres columnas en null.
  // TODO [DEUDA TÉCNICA]: las reglas "las tres columnas van juntas", "diaLimite entre 1 y 28" y
  // "mesInicioCiclo solo en BIMESTRAL" se validan solo en la capa de aplicación (Zod
  // PeriodicidadSchema), igual que sector/subtipo. El mapper no corrige estados inconsistentes.
  periodicidadTipo           PeriodicidadTipo?
  /// Día del mes límite para rendir (1 a 28).
  periodicidadDiaLimite      Int?              @db.SmallInt
  /// Mes (1 a 12) en que arranca el ciclo bimestral. Null para MENSUAL y POR_CAMPANIA.
  periodicidadMesInicioCiclo Int?              @db.SmallInt

  // Categorización (ADR-0002 §2)
  sector   Sector
  subtipo  SubtipoPublico? // null para clientes PRIVADO

  // Estado comercial (ADR-0002 §3)
  estado  ClienteEstado @default(ACTIVO)

  // Baja lógica (ADR-0002 §3)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?

  // Auditoría (ADR-0002 §4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contactos  Contacto[]
}

// ─── Modelo Contacto ──────────────────────────────────────────────────────────

model Contacto {
  id                String   @id @default(uuid()) @db.Uuid

  nombre            String   @db.VarChar(150)
  area              String   @db.VarChar(100)
  email             String   @db.VarChar(254)
  recibeRendiciones Boolean  @default(false)

  // Relación con Cliente
  clienteId         String   @db.Uuid
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Baja lógica (HU1.3)
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?

  // Auditoría
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
