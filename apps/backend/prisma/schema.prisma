generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (isomorfos al schema Zod en @realpolitik/shared) ──────────────────

enum Sector {
  PUBLICO
  PRIVADO
}

enum SubtipoPublico {
  MUNICIPAL
  PROVINCIAL_ORGANISMO
  SINDICAL_OBRA_SOCIAL
}

enum IvaCondicion {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_CATEGORIZADO
}

enum ClienteEstado {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

/// Canal habitual por el que se entregan las rendiciones al cliente (HU1.4).
enum CanalEntrega {
  CORREO
  PORTAL_WEB
  WHATSAPP
}

/// Periodicidad con la que se rinde al cliente (HU1.5).
enum PeriodicidadTipo {
  MENSUAL
  BIMESTRAL
  POR_CAMPANIA
}

// ─── Modelo Cliente ───────────────────────────────────────────────────────────

// Reglas de integridad de Cliente y Contacto: se validan PRIMERO en la aplicación (shared/Zod y
// el backend, que responden 400) y PostgreSQL además las garantiza con CHECK constraints definidos
// en SQL, en la migración `20261010120000_integridad_cliente_contacto`. Prisma Schema no puede
// representar esos CHECK: no aparecen acá, pero `prisma migrate deploy` los crea y la base
// rechaza cualquier escritura que los viole (scripts, Prisma Studio, SQL manual).
//   ck_cliente_sector_subtipo         PUBLICO ⇒ subtipo; PRIVADO ⇒ sin subtipo
//   ck_cliente_portal_requerido       PORTAL_WEB ⇒ portalUrl no vacía
//   ck_cliente_whatsapp_requerido     WHATSAPP ⇒ whatsappNumero no vacío
//   ck_cliente_periodicidad_coherente sin configurar, o tipo + día 1..28 (+ mes 1..12 si BIMESTRAL)
//   ck_cliente_baja_logica            isDeleted ⇔ deletedAt
//   ck_contacto_baja_logica           isDeleted ⇔ deletedAt

model Cliente {
  id            String  @id @default(uuid()) @db.Uuid

  // Datos de identificación
  razonSocial   String  @db.VarChar(150)
  /// Denominación corta o alias del cliente. Obligatorio. Máx 60 chars.
  /// Es el identificador visual principal en la UI cuando razonSocial es extensa.
  denominacion  String  @db.VarChar(60)

  // Datos fiscales y de contacto
  cuit               String   @unique @db.VarChar(13) // formato XX-XXXXXXXX-X
  ivaCondicion       IvaCondicion
  emailContacto      String   @db.VarChar(254)
  emailsAdicionales  String[] @default([])
  telefono           String?  @db.VarChar(25)
  portalUrl          String?  @db.VarChar(500)

  // Canal de entrega habitual. "PORTAL_WEB ⇒ portalUrl" y "WHATSAPP ⇒ whatsappNumero": shared
  // (superRefine) + CHECK ck_cliente_portal_requerido / ck_cliente_whatsapp_requerido. No se exige
  // que los datos de los otros canales estén vacíos.
  canalEntrega       CanalEntrega @default(CORREO)
  /// Número de WhatsApp normalizado a E.164 (+5493511234567). Obligatorio si canalEntrega = WHATSAPP.
  whatsappNumero     String?  @db.VarChar(16)

  // Periodicidad de rendición (HU1.5). Sin configurar = las tres columnas en null. "Las tres van
  // juntas", "diaLimite 1..28" y "mesInicioCiclo solo en BIMESTRAL": shared (PeriodicidadSchema)
  // + CHECK ck_cliente_periodicidad_coherente.
  periodicidadTipo           PeriodicidadTipo?
  /// Día del mes límite para rendir (1 a 28).
  periodicidadDiaLimite      Int?              @db.SmallInt
  /// Mes (1 a 12) en que arranca el ciclo bimestral. Null para MENSUAL y POR_CAMPANIA.
  periodicidadMesInicioCiclo Int?              @db.SmallInt

  // Categorización (ADR-0002 §2). shared + CHECK ck_cliente_sector_subtipo.
  sector   Sector
  subtipo  SubtipoPublico? // null para clientes PRIVADO

  // Estado comercial (ADR-0002 §3). SUSPENDIDO existe pero está reservado: la API no lo asigna y
  // la UI no lo ofrece ni lo lista.
  estado  ClienteEstado @default(ACTIVO)

  // Baja lógica (ADR-0002 §3). CHECK ck_cliente_baja_logica: isDeleted ⇔ deletedAt.
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?

  // Auditoría (ADR-0002 §4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contactos  Contacto[]
}

// ─── Modelo Contacto ──────────────────────────────────────────────────────────

model Contacto {
  id                String   @id @default(uuid()) @db.Uuid

  nombre            String   @db.VarChar(150)
  area              String   @db.VarChar(100)
  email             String   @db.VarChar(254)
  recibeRendiciones Boolean  @default(false)

  // Relación con Cliente
  clienteId         String   @db.Uuid
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Baja lógica (HU1.3). CHECK ck_contacto_baja_logica: isDeleted ⇔ deletedAt.
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?

  // Auditoría
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
