generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (isomorfos al schema Zod en @realpolitik/shared) ──────────────────

enum Sector {
  PUBLICO
  PRIVADO
}

enum SubtipoPublico {
  MUNICIPAL
  PROVINCIAL_ORGANISMO
  SINDICAL_OBRA_SOCIAL
}

enum IvaCondicion {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_CATEGORIZADO
}

enum ClienteEstado {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

/// Canal habitual por el que se entregan las rendiciones al cliente (HU1.4).
enum CanalEntrega {
  CORREO
  PORTAL_WEB
  WHATSAPP
}

/// Emisor con el que se factura (HU2.9): persona física o sociedad. Isomorfo con `Emisor` de shared.
enum Emisor {
  PERSONA_FISICA
  SOCIEDAD
}

/// En qué paso está una rendición (HU3.1, ADR-0005). Isomorfo con `EstadoRendicion` de shared.
/// "Atrasada" no es un estado: se calcula (HU3.4). La anulación es aparte (`isDeleted`).
enum EstadoRendicion {
  EN_CURSO
  COMPLETA
  ENVIADA
  APROBADA
  RECHAZADA
}

/// Rol fijo de negocio (épica 4, ADR-0006). Isomorfo con `RolUsuario` de shared. No depende del
/// área de la persona; los permisos de cada rol se declaran en el código, no en la base.
enum RolUsuario {
  ADMINISTRADOR
  ADMINISTRATIVO
  CONSULTA
}

/// Periodicidad con la que se rinde al cliente (HU1.5).
enum PeriodicidadTipo {
  MENSUAL
  BIMESTRAL
  POR_CAMPANIA
}

// ─── Modelo Cliente ───────────────────────────────────────────────────────────

// Reglas de integridad de Cliente y Contacto: se validan PRIMERO en la aplicación (shared/Zod y
// el backend, que responden 400) y PostgreSQL además las garantiza con CHECK constraints definidos
// en SQL, en la migración `20261010120000_integridad_cliente_contacto`. Prisma Schema no puede
// representar esos CHECK: no aparecen acá, pero `prisma migrate deploy` los crea y la base
// rechaza cualquier escritura que los viole (scripts, Prisma Studio, SQL manual).
//   ck_cliente_sector_subtipo         PUBLICO ⇒ subtipo; PRIVADO ⇒ sin subtipo
//   ck_cliente_portal_requerido       PORTAL_WEB ⇒ portalUrl no vacía
//   ck_cliente_whatsapp_requerido     WHATSAPP ⇒ whatsappNumero no vacío
//   ck_cliente_periodicidad_coherente sin configurar, o tipo + día 1..28 (+ mes 1..12 si BIMESTRAL)
//   ck_cliente_baja_logica            isDeleted ⇔ deletedAt
//   ck_contacto_baja_logica           isDeleted ⇔ deletedAt
//
// Requisitos y rendiciones (T2.1, ADR-0003): CHECK e índice parcial en la migración
// `20261020033424_t2_1_requisitos_rendiciones`.
//   ck_requisito_cantidad_positiva    cantidad >= 1
//   ck_requisito_dias_coherentes      sin días, o exactamente tantos días como la cantidad
//   ck_requisito_dias_rango           cada día entre 1 y 31 (y ninguno NULL)
//   ck_requisito_baja_logica          isDeleted ⇔ deletedAt
//   ck_rendicion_mes                  mes 1..12 y anio 2020..2100
//   ck_rendicion_numero_factura_no_vacio numeroFactura con algún carácter que no sea espacio
//   ck_rendicion_baja_logica          isDeleted ⇔ deletedAt
//   ck_item_ordinal                   1 <= ordinal <= totalOrdinal
//   ck_item_completado_coherente      completado ⇔ completadoAt
//   ck_item_dia_rango                 diaAproximado NULL o entre 1 y 31
//   uq_requisito_cliente_tipo_activo  índice único PARCIAL: un solo requisito activo por
//                                     cliente + tipo de documento (WHERE "isDeleted" = false)
//   uq_rendicion_factura_activa       (reemplazado en HU2.9, ver abajo) índice único PARCIAL: un
//                                     número de factura en una sola rendición activa del cliente
// T2.1b: la migración `20261020151824_t2_1b_rendicion_numero_factura` renombra la columna
// `referencia` a `numeroFactura` y reemplaza ck_rendicion_referencia_no_vacia y
// uq_rendicion_periodo_activa por los de arriba.
// HU2.1: la migración `20261021120000_hu2_1_tipo_documento_nombre_normalizado` agrega
// `TipoDocumento.nombreNormalizado` (único) y quita la unicidad exacta de `nombre`.
//
// Emisor de la rendición (HU2.9, ADR-0003 punto 11): la migración
// `20261030130000_hu2_9_emisor_rendicion` agrega `Rendicion.emisor` y reemplaza
// uq_rendicion_factura_activa por dos índices únicos PARCIALES, ambos sobre las rendiciones
// activas (WHERE "isDeleted" = false, el mismo predicado de antes):
//   uq_rendicion_emisor_factura_activa     (emisor, numeroFactura) entre las que tienen emisor,
//                                          aunque sean de clientes distintos (AND "emisor" IS NOT NULL)
//   uq_rendicion_factura_activa_sin_emisor (clienteId, numeroFactura) entre las que no tienen
//                                          emisor: la regla anterior, para las rendiciones
//                                          existentes (AND "emisor" IS NULL)
//
// Orden de compra de la rendición (HU2.11, ADR-0003): CHECK en la migración
// `20261030140000_hu2_11_orden_compra_rendicion`. El número de OC no tiene índice único.
//   ck_rendicion_numero_oc_no_vacio     numeroOc NULL o con algún carácter que no sea espacio
//   ck_rendicion_montos_oc_no_negativos montoMensual y montoTotal NULL o >= 0
//
// Cobro informado por el cliente (HU3.10, ADR-0005 punto 13): CHECK en la migración
// `20261113120000_hu3_10_cobro_rendicion`. Sin índice, sin CHECK de fecha futura (depende del
// reloj) ni de estado (lo decide el servicio).
//   ck_rendicion_cobro_nota_con_fecha  cobroNota NULL o con cobroFecha cargada
//   ck_rendicion_cobro_nota_no_vacia   cobroNota NULL o con algún carácter que no sea espacio
//
// Estado de la rendición (HU3.1, ADR-0005): la migración `20261103120000_hu3_1_estado_rendicion`
// agrega `Rendicion.estado` y la tabla `HistorialEstadoRendicion`, y le da a cada rendición
// existente (también a las anuladas) el estado EN_CURSO con su entrada inicial de historial.
//
// Documentos y sus aplicaciones (HU2.8, ADR-0004): CHECK e índice parcial en la migración
// `20261029120000_hu2_8_documentos_aplicaciones`.
//   ck_documento_mes                  mes 1..12 y anio 2020..2100 (como ck_rendicion_mes)
//   ck_documento_tamanio_positivo     tamanioBytes > 0
//   ck_documento_sha256_formato       64 caracteres hexadecimales en minúscula
//   ck_documento_nombre_original_no_vacio nombreOriginal con algún carácter que no sea espacio
//   ck_documento_tipo_contenido_formato tipoContenido con forma de MIME (tipo/subtipo, minúsculas)
//   ck_documento_clave_no_vacia       claveAlmacenamiento con algún carácter que no sea espacio
//   ck_aplicacion_fechas_coherentes   reemplazadaEn NULL o posterior o igual a aplicadaEn
//   ck_aplicacion_no_se_reemplaza_a_si_misma reemplazaAId distinto de id
//   uq_aplicacion_documento_item_vigente índice único PARCIAL: una sola aplicación vigente por
//                                     ítem (WHERE "reemplazadaEn" IS NULL)
//
// Usuarios y sesiones (HU4.1, ADR-0006): CHECK en la migración `20261111120000_hu4_1_usuarios_sesiones`.
//   ck_usuario_email_normalizado      email en minúscula, sin espacios en los bordes y con forma x@y
//   ck_usuario_nombre_no_vacio        nombre con algún carácter que no sea espacio
//   ck_usuario_password_hash_argon2id passwordHash en formato PHC de argon2id: impide guardar una
//                                     contraseña en claro o con otro algoritmo por error
//   ck_sesion_token_hash_formato      tokenHash: SHA-256 en hexadecimal en minúscula
//   ck_sesion_fechas_coherentes       expiraEn > createdAt; ultimaActividadEn y revocadaEn (si
//                                     existe) no anteriores a createdAt

model Cliente {
  id            String  @id @default(uuid()) @db.Uuid

  // Datos de identificación
  razonSocial   String  @db.VarChar(150)
  /// Denominación corta o alias del cliente. Obligatorio. Máx 60 chars.
  /// Es el identificador visual principal en la UI cuando razonSocial es extensa.
  denominacion  String  @db.VarChar(60)

  // Datos fiscales y de contacto
  cuit               String   @unique @db.VarChar(13) // formato XX-XXXXXXXX-X
  ivaCondicion       IvaCondicion
  emailContacto      String   @db.VarChar(254)
  emailsAdicionales  String[] @default([])
  telefono           String?  @db.VarChar(25)
  portalUrl          String?  @db.VarChar(500)

  // Canal de entrega habitual. "PORTAL_WEB ⇒ portalUrl" y "WHATSAPP ⇒ whatsappNumero": shared
  // (superRefine) + CHECK ck_cliente_portal_requerido / ck_cliente_whatsapp_requerido. No se exige
  // que los datos de los otros canales estén vacíos.
  canalEntrega       CanalEntrega @default(CORREO)
  /// Número de WhatsApp normalizado a E.164 (+5493511234567). Obligatorio si canalEntrega = WHATSAPP.
  whatsappNumero     String?  @db.VarChar(16)

  /// Emisor habitual del cliente (HU2.9). Null = pendiente de asignar: no bloquea nada. Sin valor
  /// por defecto: las filas anteriores quedan sin emisor.
  emisor             Emisor?

  // Periodicidad de rendición (HU1.5). Sin configurar = las tres columnas en null. "Las tres van
  // juntas", "diaLimite 1..28" y "mesInicioCiclo solo en BIMESTRAL": shared (PeriodicidadSchema)
  // + CHECK ck_cliente_periodicidad_coherente.
  periodicidadTipo           PeriodicidadTipo?
  /// Día del mes límite para rendir (1 a 28).
  periodicidadDiaLimite      Int?              @db.SmallInt
  /// Mes (1 a 12) en que arranca el ciclo bimestral. Null para MENSUAL y POR_CAMPANIA.
  periodicidadMesInicioCiclo Int?              @db.SmallInt

  // Matriz de requisitos (T2.1, ADR-0003). true = tiene al menos un requisito activo. La mantiene
  // el backend (false al dar de baja el último); no se edita a mano. La factura es un requisito más.
  matrizConfigurada  Boolean @default(false)
  /// Indicaciones de armado del legajo (HU2.4): texto libre, hasta 1000 caracteres.
  indicacionesArmado String? @db.VarChar(1000)
  /// Observaciones internas de la ficha (HU2.10): una nota libre que se reemplaza al guardar, hasta 1000 caracteres.
  observaciones      String? @db.VarChar(1000)

  // Categorización (ADR-0002 §2). shared + CHECK ck_cliente_sector_subtipo.
  sector   Sector
  subtipo  SubtipoPublico? // null para clientes PRIVADO

  // Estado comercial (ADR-0002 §3). SUSPENDIDO existe pero está reservado: la API no lo asigna y
  // la UI no lo ofrece ni lo lista.
  estado  ClienteEstado @default(ACTIVO)

  // Baja lógica (ADR-0002 §3). CHECK ck_cliente_baja_logica: isDeleted ⇔ deletedAt.
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?

  // Auditoría (ADR-0002 §4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contactos    Contacto[]
  requisitos   RequisitoCliente[]
  rendiciones  Rendicion[]
}

// ─── Modelo Contacto ──────────────────────────────────────────────────────────

model Contacto {
  id                String   @id @default(uuid()) @db.Uuid

  nombre            String   @db.VarChar(150)
  area              String   @db.VarChar(100)
  email             String   @db.VarChar(254)
  recibeRendiciones Boolean  @default(false)

  // Relación con Cliente
  clienteId         String   @db.Uuid
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Baja lógica (HU1.3). CHECK ck_contacto_baja_logica: isDeleted ⇔ deletedAt.
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?

  // Auditoría
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Modelo TipoDocumento ─────────────────────────────────────────────────────

/// Catálogo de tipos de documento que se pueden exigir en una rendición (T2.1).
model TipoDocumento {
  id           String   @id @default(uuid()) @db.Uuid

  /// Nombre tal como se muestra. No es único por sí solo: la unicidad la da `nombreNormalizado`.
  nombre       String   @db.VarChar(100)
  /// Clave técnica de unicidad (HU2.1, ADR-0003): el nombre sin mayúsculas ni acentos, calculado
  /// con `normalizarNombreTipoDocumento` de `@realpolitik/shared` en cada escritura. Dos tipos
  /// no pueden tener la misma clave. No forma parte de la API.
  nombreNormalizado String @unique @db.VarChar(100)
  descripcion  String?  @db.VarChar(500)
  /// Un tipo desactivado no se ofrece al armar la matriz. No se borra: lo usan requisitos e
  /// ítems de rendiciones ya abiertas.
  activo       Boolean  @default(true)

  // Auditoría
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requisitos   RequisitoCliente[]
  items        ItemChecklist[]
  documentos   Documento[]
}

// ─── Modelo RequisitoCliente (matriz) ─────────────────────────────────────────

/// Un documento que el cliente exige en cada rendición (T2.1, ADR-0003). No hay requisitos
/// condicionales: todo requisito activo entra siempre en el checklist.
model RequisitoCliente {
  id               String         @id @default(uuid()) @db.Uuid

  clienteId        String         @db.Uuid
  cliente          Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoDocumentoId  String         @db.Uuid
  tipoDocumento    TipoDocumento  @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)

  /// Cuántos documentos de este tipo por período (ej. Print x5). CHECK ck_requisito_cantidad_positiva.
  cantidad         Int            @default(1) @db.SmallInt
  /// Día aproximado de cada ocurrencia (ej. [1, 8, 15, 22, 31]). Opcional: ninguno o exactamente
  /// `cantidad`. CHECK ck_requisito_dias_coherentes y ck_requisito_dias_rango.
  diasAproximados  Int[]          @default([])
  /// Canal propio de este documento. Null = usa Cliente.canalEntrega.
  canalEntrega     CanalEntrega?
  nota             String?        @db.VarChar(500)

  // Baja lógica. CHECK ck_requisito_baja_logica: isDeleted ⇔ deletedAt. La unicidad cliente + tipo
  // vale solo entre los activos: índice parcial uq_requisito_cliente_tipo_activo, en SQL.
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?

  // Auditoría
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            ItemChecklist[]
}

// ─── Modelo Rendicion ─────────────────────────────────────────────────────────

/// Una rendición del cliente para un período y una factura (T2.1, T2.1b). Puede haber varias
/// por cliente y mes, una por factura. El número de factura es único por emisor (HU2.9).
model Rendicion {
  id          String   @id @default(uuid()) @db.Uuid

  clienteId   String   @db.Uuid
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  anio        Int      @db.SmallInt
  /// Mes 1..12. CHECK ck_rendicion_mes (también acota anio a 2020..2100).
  mes         Int      @db.SmallInt
  /// Número de factura. CHECK ck_rendicion_numero_factura_no_vacio.
  numeroFactura String @db.VarChar(100)
  /// Emisor de esta factura (HU2.9). Es una foto: se copia del cliente al abrir la rendición (o se
  /// elige otro en ese momento) y no se edita. Null solo en las rendiciones anteriores a HU2.9,
  /// que siguen con la regla de unicidad por cliente.
  emisor      Emisor?

  // Orden de compra (HU2.11). Los tres datos son opcionales y de la rendición, no del cliente.
  // El número no es único: se repite entre meses, entre facturas y entre clientes (cada organismo
  // numera sus OC). CHECK ck_rendicion_numero_oc_no_vacio y ck_rendicion_montos_oc_no_negativos,
  // en SQL.
  numeroOc      String?  @db.VarChar(100)
  montoMensual  Decimal? @db.Decimal(14, 2)
  montoTotal    Decimal? @db.Decimal(14, 2)

  // Cobro informado por el cliente (HU3.10): una marca de la rendición, no un estado. `cobroFecha` es
  // el día en que el cliente avisó el pago; `cobroNota` el texto opcional (hasta 300). Sin fecha no
  // hay cobro. CHECK ck_rendicion_cobro_nota_con_fecha y ck_rendicion_cobro_nota_no_vacia, en SQL.
  cobroFecha    DateTime? @db.Date
  cobroNota     String?   @db.VarChar(300)

  /// En qué paso está (HU3.1). Nace EN_CURSO; cada cambio deja una entrada en `historial`. Una
  /// rendición anulada conserva el último estado que tenía: la anulación es `isDeleted`, aparte.
  estado      EstadoRendicion @default(EN_CURSO)

  // Baja lógica (anular una rendición mal cargada, HU2.5). CHECK ck_rendicion_baja_logica:
  // isDeleted ⇔ deletedAt. La unicidad del número de factura (en cualquier período) vale solo
  // entre las activas: con emisor, (emisor, numeroFactura) entre todos los clientes
  // (uq_rendicion_emisor_factura_activa); sin emisor, (clienteId, numeroFactura)
  // (uq_rendicion_factura_activa_sin_emisor). Índices parciales, en SQL.
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  // Auditoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ItemChecklist[]
  historial   HistorialEstadoRendicion[]

  /// Última OC del cliente (GET /clientes/:id/ultima-oc).
  @@index([clienteId, numeroOc])
  /// Atrasadas de cualquier mes (GET /rendiciones/atrasadas, HU3.4): activas, sin enviar y de un
  /// período hasta el límite.
  @@index([isDeleted, estado, anio, mes])
}

// ─── Modelo HistorialEstadoRendicion ──────────────────────────────────────────

/// Un cambio de estado de una rendición (HU3.1, ADR-0005). Es historial: no se edita ni se borra.
/// La primera entrada es la del alta (`estadoAnterior` null → EN_CURSO).
model HistorialEstadoRendicion {
  id             String           @id @default(uuid()) @db.Uuid

  rendicionId    String           @db.Uuid
  rendicion      Rendicion        @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  /// Null solo en la primera entrada.
  estadoAnterior EstadoRendicion?
  estadoNuevo    EstadoRendicion
  /// Cuándo se registró el cambio. Ordena el historial.
  fecha          DateTime         @default(now())
  /// El día en que ocurrió, si la operadora lo indicó (HU3.7): hoy, solo la fecha de envío de la
  /// entrada ENVIADA, que puede ser anterior al registro. Null en las demás.
  fechaEfectiva  DateTime?        @db.Date
  /// Por qué (lo usa el rechazo, HU3.8). Hoy siempre null.
  motivo         String?

  // Auditoría
  createdAt      DateTime         @default(now())

  /// El historial de una rendición, en orden.
  @@index([rendicionId, fecha])
}

// ─── Modelo ItemChecklist ─────────────────────────────────────────────────────

/// Un documento a presentar en una rendición. Es una FOTO del requisito tomada al abrir la
/// rendición (ADR-0003): si la matriz cambia después, el ítem no cambia. Un requisito con
/// cantidad 5 genera 5 ítems (ordinal 1..5, totalOrdinal 5).
model ItemChecklist {
  id                   String            @id @default(uuid()) @db.Uuid

  rendicionId          String            @db.Uuid
  rendicion            Rendicion         @relation(fields: [rendicionId], references: [id], onDelete: Cascade)
  /// Solo trazabilidad: de qué requisito salió. Los datos del ítem se leen de sus propias columnas.
  requisitoClienteId   String            @db.Uuid
  requisitoCliente     RequisitoCliente  @relation(fields: [requisitoClienteId], references: [id], onDelete: Restrict)

  // Snapshot copiado al abrir la rendición.
  tipoDocumentoId      String            @db.Uuid
  tipoDocumento        TipoDocumento     @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  /// Nombre del tipo tal como era al abrir la rendición.
  nombreTipoDocumento  String            @db.VarChar(100)
  /// Número de este documento dentro del requisito (1 de 5, 2 de 5…). CHECK ck_item_ordinal.
  ordinal              Int               @db.SmallInt
  totalOrdinal         Int               @db.SmallInt
  /// CHECK ck_item_dia_rango.
  diaAproximado        Int?              @db.SmallInt
  /// Canal efectivo ya resuelto: el del requisito o, si no tenía, el del cliente.
  canalEntrega         CanalEntrega

  /// Se completa solo al aplicarle un documento (HU2.8), no a mano. CHECK ck_item_completado_coherente.
  completado           Boolean           @default(false)
  completadoAt         DateTime?

  // Auditoría
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  /// Documentos aplicados a este ítem (HU2.8): la vigente y las reemplazadas, como historial.
  aplicaciones         AplicacionDocumento[]

  @@unique([rendicionId, requisitoClienteId, ordinal])
  // Lo exige la FK compuesta de `AplicacionDocumento` (ADR-0004): el documento aplicado tiene
  // que ser del mismo tipo que el ítem. `id` ya es único, así que nunca rechaza una fila.
  @@unique([id, tipoDocumentoId])
}

// ─── Modelo Documento ─────────────────────────────────────────────────────────

/// Un archivo cargado una sola vez, con su tipo y su período (HU2.8, ADR-0004). Se aplica a
/// ítems de rendiciones con `AplicacionDocumento`, sin copiarlo por cliente. El contenido no está
/// en la base: vive en el almacenamiento de objetos, bajo `claveAlmacenamiento`. Por ahora no se
/// borra (la retención no está definida).
model Documento {
  id String @id @default(uuid()) @db.Uuid

  tipoDocumentoId String        @db.Uuid
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)

  // Período del documento. CHECK ck_documento_mes (mismo rango que la rendición).
  anio Int @db.SmallInt
  mes  Int @db.SmallInt

  /// Nombre del archivo tal como llegó. Dato no confiable: solo se muestra (escapado) y nunca
  /// forma parte de la clave ni de una ruta. CHECK ck_documento_nombre_original_no_vacio.
  nombreOriginal      String @db.VarChar(255)
  /// MIME del contenido validado por el backend (no el que declara el navegador).
  /// CHECK ck_documento_tipo_contenido_formato; la lista de formatos admitidos vive en shared.
  tipoContenido       String @db.VarChar(255)
  /// CHECK ck_documento_tamanio_positivo. El tope (10 MB) lo valida shared, no la base.
  tamanioBytes        Int
  /// SHA-256 del contenido, en hexadecimal en minúscula. No es único: sirve para avisar de un
  /// posible duplicado, no para impedirlo. CHECK ck_documento_sha256_formato.
  sha256              String @db.Char(64)
  /// Clave opaca del objeto en el almacenamiento. Sin bucket, URL ni proveedor: cambiar de
  /// proveedor no cambia este valor. CHECK ck_documento_clave_no_vacia.
  claveAlmacenamiento String @unique @db.VarChar(255)

  // Auditoría. `createdAt` es la fecha de carga.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aplicaciones AplicacionDocumento[]

  // Lo exige la FK compuesta de `AplicacionDocumento`. `id` ya es único.
  @@unique([id, tipoDocumentoId])
  // Repositorio por período (y tipo).
  @@index([anio, mes, tipoDocumentoId])
  // Aviso de posible duplicado.
  @@index([sha256])
}

// ─── Modelo AplicacionDocumento ───────────────────────────────────────────────

/// Un documento aplicado a un ítem del checklist (HU2.8, ADR-0004). Es historial: una aplicación
/// no se borra. Al reemplazar, la anterior recibe `reemplazadaEn` y la nueva la apunta con
/// `reemplazaAId`. Una sola vigente por ítem: índice único parcial
/// uq_aplicacion_documento_item_vigente, en SQL. Un mismo documento puede estar vigente en
/// muchos ítems, también de la misma rendición.
model AplicacionDocumento {
  id String @id @default(uuid()) @db.Uuid

  documentoId     String        @db.Uuid
  itemChecklistId String        @db.Uuid
  /// Tipo del documento y del ítem, que tienen que coincidir: lo garantizan las dos FK compuestas
  /// de abajo, que usan esta misma columna. No se edita.
  tipoDocumentoId String        @db.Uuid
  documento       Documento     @relation(fields: [documentoId, tipoDocumentoId], references: [id, tipoDocumentoId], onDelete: Restrict)
  itemChecklist   ItemChecklist @relation(fields: [itemChecklistId, tipoDocumentoId], references: [id, tipoDocumentoId], onDelete: Restrict)

  aplicadaEn     DateTime             @default(now())
  /// Null = vigente. CHECK ck_aplicacion_fechas_coherentes.
  reemplazadaEn  DateTime?
  /// La aplicación anterior, si esta la reemplazó. Única: una aplicación se reemplaza una sola
  /// vez. La FK compuesta (con `itemChecklistId`) obliga a que sea del MISMO ítem: un reemplazo
  /// nunca encadena aplicaciones de ítems distintos. CHECK ck_aplicacion_no_se_reemplaza_a_si_misma.
  reemplazaAId   String?              @unique @db.Uuid
  reemplazaA     AplicacionDocumento? @relation("ReemplazoDeAplicacion", fields: [reemplazaAId, itemChecklistId], references: [id, itemChecklistId], onDelete: Restrict)
  reemplazadaPor AplicacionDocumento? @relation("ReemplazoDeAplicacion")

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dónde está aplicado un documento.
  @@index([documentoId])
  // Historial de un ítem (el índice parcial solo cubre las vigentes).
  @@index([itemChecklistId])
  // Destino de la FK compuesta del reemplazo. `id` ya es único.
  @@unique([id, itemChecklistId])
  // Prisma exige que los campos de una relación 1 a 1 sean únicos en conjunto. Es redundante con
  // el @unique de `reemplazaAId`, que deja la regla escrita sin tener que deducirla de la FK.
  @@unique([reemplazaAId, itemChecklistId])
}

// ─── Usuarios y sesiones (épica 4, ADR-0006) ──────────────────────────────────

/// Cuenta de una persona del equipo. Sin registro público: las crea un procedimiento técnico
/// (HU4.1) y después un `ADMINISTRADOR` (HU4.5). No se borra: se desactiva, y así conserva la
/// autoría de sus cambios (HU4.6). Sin área, teléfono ni otros datos personales: no hacen falta.
model Usuario {
  id                    String     @id @default(uuid()) @db.Uuid
  /// Identifica la cuenta para iniciar sesión. Se guarda en minúscula y sin espacios en los
  /// bordes, así la unicidad no distingue mayúsculas. CHECK ck_usuario_email_normalizado.
  email                 String     @unique @db.VarChar(254)
  /// Cómo se muestra la persona en la interfaz. CHECK ck_usuario_nombre_no_vacio.
  nombre                String     @db.VarChar(150)
  rol                   RolUsuario
  /// PHC de argon2id generado por la biblioteca: algoritmo, parámetros y sal incluidos, así los
  /// parámetros pueden cambiar sin invalidar los hashes existentes. Nunca la contraseña.
  /// CHECK ck_usuario_password_hash_argon2id.
  passwordHash          String     @db.VarChar(255)
  /// Una cuenta inactiva no puede iniciar sesión y sus sesiones dejan de valer.
  activo                Boolean    @default(true)
  /// Contraseña temporal sin cambiar: obliga a elegir una propia antes de usar el sistema.
  debeCambiarPassword   Boolean    @default(true)
  passwordActualizadaEn DateTime
  ultimoAccesoEn        DateTime?

  // Auditoría
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  sesiones Sesion[]
}

/// Sesión opaca y revocable. El token aleatorio solo vive en la cookie del navegador; acá se guarda
/// su SHA-256, que permite encontrar la sesión sin poder reconstruir el token. Una sesión vale si
/// no está revocada, no venció por inactividad ni por tiempo absoluto y su usuario está activo:
/// lo decide la aplicación con su propio reloj (las duraciones están pendientes de aprobación, P2).
model Sesion {
  id                String    @id @default(uuid()) @db.Uuid
  usuarioId         String    @db.Uuid
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// SHA-256 del token, en hexadecimal en minúscula. CHECK ck_sesion_token_hash_formato.
  tokenHash         String    @unique @db.Char(64)
  /// Última actividad registrada (como mucho una escritura por minuto).
  ultimaActividadEn DateTime  @default(now())
  /// Vencimiento absoluto, fijado al crearla. CHECK ck_sesion_fechas_coherentes.
  expiraEn          DateTime
  /// Cierre de sesión, cambio de contraseña, desactivación o cambio de rol. Nunca se "desrevoca".
  revocadaEn        DateTime?

  // Auditoría: `createdAt` es también el inicio de la sesión. Sin `updatedAt`: sus únicos cambios
  // (actividad y revocación) tienen columna propia.
  createdAt         DateTime  @default(now())

  // Sesiones de un usuario: límite de vigentes, revocación de todas y limpieza.
  @@index([usuarioId])
}
