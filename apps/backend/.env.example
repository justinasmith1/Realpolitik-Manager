# Variables del backend. Copiá este archivo a .env (Git lo ignora) y ajustá los valores.
# Si falta o es inválida alguna, el servidor no arranca y nombra la variable (sin mostrar su valor).

# development | test | production (default: development)
NODE_ENV=development

# Puerto del servidor, entero entre 1 y 65535 (default: 3000)
PORT=3000

# URL de conexión a PostgreSQL que usa Prisma. Obligatoria.
# Ajustá el puerto si el de tu Docker no es el 5432 (ver POSTGRES_PORT en el .env de la raíz).
DATABASE_URL="postgresql://realpolitik:realpolitik_dev@localhost:5432/realpolitik_db?schema=public"

# Orígenes del frontend permitidos por CORS, separados por comas, sin barra final. Obligatoria.
CORS_ORIGINS=http://localhost:5173

# Almacenamiento de los archivos de documentos (HU2.8, ADR-0004): memoria | disco | s3.
# Sin definirla: memoria con NODE_ENV=test y disco con NODE_ENV=development (definido). En
# producción es obligatoria y solo admite s3.
# ALMACENAMIENTO=disco

# Carpeta del almacenamiento en disco, relativa a apps/backend (default: .almacenamiento-local,
# que Git ignora). Usá datos ficticios: no hay autenticación.
# ALMACENAMIENTO_DIRECTORIO=.almacenamiento-local

# Almacenamiento S3-compatible (Supabase Storage, R2, MinIO). Obligatorias con ALMACENAMIENTO=s3.
# Bucket PRIVADO. Las claves de acceso son secretas: nunca en el repo ni en el frontend.
# S3_ENDPOINT=https://<proyecto>.supabase.co/storage/v1/s3
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# true (default): el bucket va en la ruta, como exige Supabase.
# S3_FORCE_PATH_STYLE=true
