# Variables del backend. Copiá este archivo a .env (Git lo ignora) y ajustá los valores.
# Si falta o es inválida alguna, el servidor no arranca y nombra la variable (sin mostrar su valor).

# development | test | production (default: development)
NODE_ENV=development

# Puerto del servidor, entero entre 1 y 65535 (default: 3000)
PORT=3000

# URL de conexión a PostgreSQL que usa Prisma. Obligatoria.
# Ajustá el puerto si el de tu Docker no es el 5432 (ver POSTGRES_PORT en el .env de la raíz).
DATABASE_URL="postgresql://realpolitik:realpolitik_dev@localhost:5432/realpolitik_db?schema=public"

# Orígenes del frontend permitidos por CORS, separados por comas, sin barra final. Obligatoria.
CORS_ORIGINS=http://localhost:5173
